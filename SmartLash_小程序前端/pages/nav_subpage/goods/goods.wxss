/* pages/nav_subpage/goods/goods.wxss */

.container {
  padding: 0;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.banner-container {
  width: 100%;
  padding: 20rpx 0; 
  box-sizing: border-box; 
}

.banner {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 24rpx; 
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f5f5f5;
  margin: 0 auto;
}

.banner-image {
  width: 85%;
  height: 85%;
  max-height: 100%;
  border-radius: 16rpx;
  object-fit: contain;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

@media (min-aspect-ratio: 1/1) {
  .banner-image {
    width: auto;
    height: 100%;
  }
}


.banner::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 30%;
  background: linear-gradient(to top, rgba(0,0,0,0.1), transparent);
  pointer-events: none;
}

.nav-container {
  position: relative;
  padding: 20rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.product-categories {
  display: flex;
  white-space: nowrap;
  height: 80rpx;
  line-height: 80rpx;
}

.category {
  position: relative;
  display: inline-block;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
  flex-shrink: 0;
}

.category.active {
  color: #ff4f4f;
  font-weight: bold;
  font-size: 32rpx;
}

.category.active .underline {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #ff4f4f, #ff8e8e);
  border-radius: 3rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  width: 90%;
  justify-content: space-between;
  padding: 0 10rpx;
  margin-bottom: 10rpx;
}

.product {
  width: 48%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s;
}

.product:active {
  transform: scale(0.98);
}

.product-image {
  width: 100%;
  height: 300rpx;
  display: block;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 26rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  height: 72rpx;
  line-height: 36rpx;
}

.price-container {
  display: flex;
  align-items: center;
  margin-top: 5rpx;
}

.product-price {
  font-size: 32rpx;
  color: #ff4f4f;
  font-weight: bold;
}

.product-original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: linear-gradient(90deg, #ff9a9e, #fad0c4);
  color: #fff;
  font-size: 20rpx;
  border-radius: 20rpx;
  margin-top: 10rpx;
}