<!--pages/my_content/app_settings/app_settings.wxml-->
<page-meta>
  <navigation-bar title="设置" front-color="black" background-color="#F0F0F0"></navigation-bar>
</page-meta>  

<text class="title">软件</text>
<view class="setting_back">
  <text class="setting_title">夜间模式</text>
  <view class="setting_funcation">
    <switch checked="{{is_night}}" bindchange="night_switch" type="switch"></switch>
  </view>
</view>

<text class="title">数据</text>
<view class="setting_back">
  <text class="setting_title">本地缓存</text>
  <view class="setting_funcation" bindtap = "storage_open">
    <image style="width: 80rpx; height: 80rpx;" src="cloud://intelligence-eyelas-5cp2d403d836.696e-intelligence-eyelas-5cp2d403d836-1323971123/images/my_swiper/enter_icon.png" mode="aspectFill"> </image>
  </view>
</view>

<text class="title">隐私</text>
<view class="setting_back">
  <text class="setting_title">权限设置</text>
  <view class="setting_funcation" bindtap = "checkCameraPermission">
    <image style="width: 80rpx; height: 80rpx;" src="cloud://intelligence-eyelas-5cp2d403d836.696e-intelligence-eyelas-5cp2d403d836-1323971123/images/my_swiper/enter_icon.png" mode="aspectFill"> </image>
  </view>
</view>
<button class="exit_button" bindtap = "exit">退出登陆</button>

<view class="dialog-container" wx:if="{{isVirsDialogVisible}}">  
  <view class="dialog">  
    <view class="dialog-button" bindtap= "dialog_cancel" >
      <image style="width: 100%; height: 100%;" src="cloud://intelligence-eyelas-5cp2d403d836.696e-intelligence-eyelas-5cp2d403d836-1323971123/images/analysis_swiper/one_item/camera_face/dialog_close.png" mode="scaleToFill"></image>
    </view>
    <view class="dialog-title">  
      <text style="font-size: 18px; margin-top: 5px;">本地缓存</text>  
    </view>  
    <view>
      <text class="dialog-tip">是否清除本地缓存</text>
      <view style="width: 100%; height: 100rpx; display: flex; flex-direction: row; margin-top: 30rpx;">
        <button class="dialog-button-chexk" style="background-color: gray;" bindtap= "dialog_cancel">取消</button>
        <button class="dialog-button-chexk" style=" background-color: #04BE02;" bindtap = "clear_storage">确定</button>
      </view>
    </view>
  </view>  
</view>  






