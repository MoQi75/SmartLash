/* pages/my_content/app_settings/app_settings.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color:gainsboro;
  align-items: center;
}


.title{
  width: 100%;
  height: 80rpx; 
  display: flex;
  padding-left: 5%;
  font-size: large;
  font-weight: bold;
  justify-content: flex-start; 
  align-items: flex-end;
}

.setting_back{
  width: 95%;
  height: 90rpx;
  display: flex;
  margin-top: 20rpx;
  flex-direction: row;
  border-radius: 30rpx;
  background-color: white;
}
.setting_title{
  width: 50%;
  height: 100%;
  display: flex;
  padding-left: 5%;
  align-items: center;
  justify-content:flex-start;

}
.setting_funcation{
  width: 50%;
  height: 100%;
  display: flex;
  padding-right: 5%;
  align-items: center;
  justify-content: flex-end;
}


.exit_button{
  width: 95%;
  height: 100rpx;
  margin-top: 700rpx;
  display: flex;
  border-radius: 20rpx;
  background-color: white;
  align-items: center;
  justify-content: center;
}

.dialog-container {  
  position: fixed;  
  top: 0;  
  left: 0;  
  right: 0;  
  bottom: 0;  
  background-color: rgba(0, 0, 0, 0.4); 
  display: flex;  
  flex-direction: column;
  justify-content: center;  
  align-items: center;  
  z-index: 1000; 
}  
  
.dialog {  
  width: 80%;
  height: 200px;
  display: flex;
  flex-direction: column;
  background-color: #fff;  
  border-radius: 20rpx;  
  padding: 20rpx;  
  position: fixed;
}  
.dialog-title {  
  display: flex;
  flex-direction: column;
  text-align: center;  
}  
.dialog-button{
  width: 40px;
  height: 40px;
  position: absolute;
  top: 10;
  left: 85%;
  border-radius: 20px;
}
.dialog-tip{
  width: 100%;
  height: 60%;
  display: flex;
  margin-top: 20rpx;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: bold;
}
.dialog-button-chexk{
  width: 40% !important;
  height: 100rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}
