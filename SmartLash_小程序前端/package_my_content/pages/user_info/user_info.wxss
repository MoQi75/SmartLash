/* pages/my_content/user_info/user_info.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.window_view_info{
  width: 100%;
  height: auto;
  display: flex;
  margin-top: 10px;
  flex-direction: column;
  background-color: white;
}
.info{
  width: 100% ;
  height: 50px;
  display: flex;
  flex-direction: row;
}

.info_item_title{
  width: 40px;
  height: auto;
  display: flex;
  margin-left: 5%;
  align-items: center;
}
.info_item_content{
  width: 80%;
  height: auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.info_item_end{
  width: 25px;
  height: 25px;
  margin: 12.5px;
}


.info_item_interval{
  width: 100%;
  height: 0.5px;
  margin-top: 5px;
  background-color: rgb(230, 230, 230);
  margin-left: 60px;
}


/* index.wxss */  
.dialog-container {  
  position: fixed;  
  top: 0;  
  left: 0;  
  right: 0;  
  bottom: 0;  
  background-color: rgba(0, 0, 0, 0.2); /* 半透明背景 */  
  display: flex;  
  flex-direction: column;
  justify-content: center;  
  align-items: center;  
  z-index: 1000; /* 确保弹窗在最顶层 */  
}  
  
.dialog {  
  background-color: #fff;  
  border-radius: 20rpx;  
  overflow: hidden;  
  padding: 20rpx;  
}  
  
.dialog-title {  
  text-align: center;  
}  

.dialog-input{
  width: 90%;
  height: 40px;
  display: flex;
  margin-top: 20px;
  margin-left: 15px;
  margin-bottom: 10px;
  align-self:center;
  justify-content: center;
  align-items: center;
  background-color: whitesmoke;
}

.dialog-footer {  
  display: flex;  
  flex-direction: row;
  justify-content: center;  
  margin-top: 20rpx;  
}  
  
.dialog-footer button {  
  width: 130px !important;
  height: 40px;
  margin: 10px;
  color: #fff;  
  border-radius: 10px;  
}
