/* package_my_content/pages/app_use/app_use.wxss */
page {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color:gainsboro;
}


.container {
  padding: 0;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  background-color: #f8f8f8;
  color: #333;
}

.modern-header {
  padding: 15px;
  width: 90%;
  height: 200px;
}

.header-container {
  background: white;
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 6px 18px rgba(255, 107, 129, 0.12);
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255, 107, 129, 0.15);
}

.header-container::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(to bottom, #FF6B81, #FFB6C1);
}

.title-box {
  padding-left: 15px;
}

.main-title {
  font-size: 22px;
  font-weight: 700;
  color: #333;
  margin-bottom: 6px;
  letter-spacing: 0.5px;
  position: relative;
  display: inline-block;
}

.main-title::after {
  content: "";
  position: absolute;
  bottom: -3px;
  left: 0;
  width: 40px;
  height: 3px;
  background: #FF6B81;
  border-radius: 3px;
}

.sub-title {
  font-size: 15px;
  color: #666;
  font-weight: 400;
}

.badge {
  position: absolute;
  bottom: 15px;
  right: 15px;
  background: #FF6B81;
  color: white;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
}

@media (max-width: 480px) {
  .header-container {
    padding: 20px;
  }
  .main-title {
    font-size: 20px;
  }
  .sub-title {
    font-size: 14px;
  }
}

.card {
  background-color: white;
  border-radius: 12px;
  padding: 20px;
  margin: 0 15px 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 15px;
  display: flex;
  align-items: center;
  color: #ff6b81;
}

.section-number {
  background-color: #ff6b81;
  color: white;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  font-size: 14px;
}

.step {
  display: flex;
  margin-bottom: 15px;
}

.step-icon {
  background-color: #ff9a9e;
  color: white;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
  font-size: 12px;
}

.step-content {
  flex: 1;
}

.step-title {
  font-weight: bold;
  margin-bottom: 5px;
  color: #555;
}

.step-desc {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.step-desc view {
  margin-bottom: 3px;
}

.faq-item {
  margin-bottom: 15px;
  padding-bottom: 15px;
  border-bottom: 1px dashed #eee;
}

.faq-question {
  font-weight: bold;
  color: #ff6b81;
  margin-bottom: 8px;
}

.faq-answer {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.faq-answer view {
  margin-bottom: 3px;
}


/* 结尾样式 */
.footer {
  position: relative;
  margin-top: 30px;
  width: 85%;
  background: linear-gradient(to bottom, #f8f8f8, #ffffff);
}

.footer-wave {
  position: absolute;
  top: -20px;
  left: 0;
  width: 100%;
  height: 40px;
  overflow: hidden;
}

.wave {
  position: absolute;
  width: 200%;
  height: 100%;
  background-repeat: repeat-x;
  background-size: 50% 100%;
}

.wave1 {
  background-image: radial-gradient(circle at 50% 0, white 25%, transparent 25.5%);
  background-position: 0 0;
  animation: wave 8s linear infinite;
  opacity: 0.7;
}

.wave2 {
  background-image: radial-gradient(circle at 50% 0, white 30%, transparent 30.5%);
  background-position: 0 10px;
  animation: wave 10s linear infinite reverse;
  opacity: 0.4;
}

@keyframes wave {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.footer-content {
  padding: 40px 20px 20px;
  text-align: center;
}

.footer-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.logo-icon {
  font-size: 24px;
  margin-right: 8px;
}

.logo-text {
  font-size: 20px;
  font-weight: bold;
  color: #FF6B81;
}

.footer-message {
  margin-bottom: 25px;
}

.message-text {
  font-size: 16px;
  color: #555;
  margin-bottom: 5px;
}

.message-desc {
  font-size: 14px;
  color: #888;
}

.contact-info {
  margin: 25px 0;
  padding: 15px 0;
  border-top: 1px dashed #eee;
  border-bottom: 1px dashed #eee;
}

.contact-item {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 0;
}

.contact-icon {
  margin-right: 8px;
  font-size: 16px;
}

.contact-text {
  font-size: 14px;
  color: #666;
}

.copyright {
  font-size: 12px;
  color: #999;
  margin-top: 15px;
}

@media (min-width: 768px) {
  .header {
    height: 220px;
  }
  
  .main-title {
    font-size: 40px;
  }
  
  .sub-title {
    font-size: 22px;
  }
  
  .card {
    margin: 0 auto 20px;
    max-width: 700px;
  }
}