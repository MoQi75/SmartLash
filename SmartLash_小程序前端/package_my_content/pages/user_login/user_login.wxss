/* pages/my_content/user_login/user_login.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
/* 登陆页面欢迎语格式 */
.info_text{
  width: auto;
  height: auto;
  margin-top: 25%;
  margin-bottom: 5%;
  margin-left: 15%;
  display: flex;
  align-self: flex-start;
}
.info_image{
  width: 400rpx;
  height: 400rpx;
  display: flex;
  align-self: center;
  margin-bottom: 5%;
}
/* 登录注册模块页面格式 */
.info{
  width: 100%;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.info_login_create_button{
  width: 75% !important;
  height: 90rpx;
  display: flex;
  border-radius: 15rpx;
  justify-content: center;
  background-color: #04BE02;
  font-weight: bold;
  margin: 5rpx;
}
.info_check{
  width: 75% !important;
  display: flex;
  flex-direction: row;
  margin-top: 2%;
  align-items: center;
  font-size:smaller;
}
.info_pact_text{
  color: blue;
}

.vires_title{
  width: 100%;
  height: auto;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.vires_title_icon{
  width: 50rpx;
  height: 50rpx;
}
.vires_content{
  width: 100%;
  height: auto;
  display: flex;
  flex-direction: column;
}